# Copy to .env and fill in locally. Never commit .env.

# Required for live ERCOT Public API calls. Leave blank to run demo mode.
ERCOT_USERNAME=
ERCOT_PASSWORD=
ERCOT_SUBSCRIPTION_KEY=

# Published ERCOT public client id from the registration guide.
# A client secret is not part of the documented ROPC flow.
ERCOT_CLIENT_ID=fec253ea-0d06-4272-a5e6-b478baeecd70

# demo (default, bundled synthetic data) or live (requires the three credentials above)
GRIDSIGNAL_DATA_MODE=demo

# Optional local explanation model. The app works with this unset.
GRIDSIGNAL_LLM_PROVIDER=template
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
